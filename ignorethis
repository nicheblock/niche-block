<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super Big Image Display</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #111; /* Dark background to make the large image pop */
            overflow: hidden; /* Prevents scrollbars */
        }
        img {
            width: 95vw; /* Fills 95% of the viewport width */
            height: 95vh; /* Fills 95% of the viewport height */
            object-fit: contain; /* Makes it as big as possible without stretching or cropping */
        }
    </style>
</head>
<body>

    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRhENHFp0qWH-ghK0RVSAEtNvjShRZTNoWdqw&s" alt="Super Big Image">

</body>
</html>
