      transition: all 0.25s; border: 1px solid rgba(255,255,255,0.1);
      display: flex; flex-direction: column; overflow: hidden;
    }
    .card:hover { transform: translateY(-4px); border-color: var(--hc); box-shadow: 0 8px 24px color-mix(in srgb, var(--hc) 25%, transparent); }
