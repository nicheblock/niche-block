    let games = [], categories = [], currentGame = null, perfMode = false;

    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        const p = JSON.parse(stored);
        games = p.games || initialGames;
        categories = p.categories || initialCategories;
      } else {
        games = initialGames;
        categories = initialCategories;
        save();
      }
    } catch(e) { games = initialGames; categories = initialCategories; }

    function save() {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ games, categories })); } catch(e) {}
    }

    // Extract bare src from a single <iframe> tag to avoid nested-iframe slowness
    function extractSrc(embedCode) {
      var t = embedCode.trim();
      if (!/^<iframe\b/i.test(t)) return null;
      var m = t.match(/\bsrc\s*=\s*["']([^"']+)["']/i);
      return m ? m[1] : null;
    }

    // Open game in a fresh about:blank tab - no sandbox restrictions
    function openFullscreen(game) {
      var win = window.open('', '_blank');
      if (!win) { alert('Pop-up blocked. Allow pop-ups and try again.'); return; }
      win.document.open();
      win.document.write(
        '<!DOCTYPE html><html style="margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:#000">' +
        '<head><meta charset="utf-8"><title>' + game.name.replace(/</g,'&lt;') + '</title></head>' +
        '<body style="margin:0;padding:0;width:100%;height:100%;overflow:hidden;display:flex;align-items:center;justify-content:center;">' +
        game.embedCode +
        '</body></html>'
      );
      win.document.close();
    }

    function launchGame(game) {
      currentGame = game;
      document.getElementById('overlay-title').textContent = game.name;
      var wrap = document.getElementById('iframe-wrap');
      var src = extractSrc(game.embedCode);
      if (src) {
        wrap.innerHTML = '<iframe src="' + src.replace(/"/g,'&quot;') + '" allow="pointer-lock; fullscreen; autoplay; gamepad" sandbox="allow-scripts allow-same-origin allow-popups allow-forms allow-pointer-lock allow-downloads allow-modals" allowfullscreen></iframe>';
      } else {
        var safe = game.embedCode.replace(/&/g,'&amp;').replace(/"/g,'&quot;');
        wrap.innerHTML = '<iframe srcdoc="' + safe + '" allow="pointer-lock; fullscreen; autoplay; gamepad" sandbox="allow-scripts allow-same-origin allow-popups allow-forms allow-pointer-lock allow-downloads allow-modals" allowfullscreen></iframe>';
      }
      document.getElementById('overlay').classList.add('active');
    }

    function getCardImg(game) { return DEFAULT_ICON || game.imageUrl || ''; }

    function renderGrid(filter) {
      filter = (filter || '').toLowerCase();
      var main = document.getElementById('main-content');
      main.innerHTML = '';
      if (!games.length) {
        main.innerHTML = '<div class="empty-state">No games yet. Click + to add your first game!</div>';
        return;
      }
      var anyVisible = false;
      categories.forEach(function(cat) {
        var catGames = cat.gameIds
          .map(function(id) { return games.find(function(g) { return g.id === id; }); })
          .filter(Boolean)
          .filter(function(g) { return !filter || g.name.toLowerCase().includes(filter); });
        if (catGames.length === 0 && filter) return;
        anyVisible = true;
        var section = document.createElement('div');
        section.className = 'category-section';
        section.innerHTML =
          '<div class="category-header">' +
            '<span class="category-label">' + cat.name.replace(/</g,'&lt;') + '</span>' +
            '<span class="category-count">(' + catGames.length + ')</span>' +
            '<div class="category-line"></div>' +
          '</div>';
        var grid = document.createElement('div');
        grid.className = 'grid';
        catGames.forEach(function(game) {
          var el = document.createElement('div');
          if (CARD_STYLE === 'text') {
            el.className = 'card-text';
            el.innerHTML = '<span style="font-size:1rem;">&#9654;</span><span class="card-text-title">' + game.name.replace(/</g,'&lt;') + '</span>';
          } else {
            var img = getCardImg(game);
            el.className = 'card';
            el.innerHTML =
              (img ? '<div class="card-img-wrap"><img src="' + img.replace(/"/g,'&quot;') + '" alt="" class="card-img" onerror="this.parentNode.style.display=\'none\'"><div class="card-play"><span class="card-play-icon">&#9654;</span></div></div>' : '') +
              '<div class="card-body"><div class="card-title">' + game.name.replace(/</g,'&lt;') + '</div></div>';
          }
          el.onclick = function() { launchGame(game); };
          grid.appendChild(el);
        });
        section.appendChild(grid);
        main.appendChild(section);
      });
      if (!anyVisible) main.innerHTML = '<div class="empty-state">No games match "' + filter.replace(/</g,'&lt;') + '"</div>';
    }

    document.getElementById('back-btn').onclick = function() {
      document.getElementById('overlay').classList.remove('active');
      document.getElementById('iframe-wrap').innerHTML = '';
      currentGame = null;
    };
    document.getElementById('fs-btn').onclick = function() {
      if (currentGame) openFullscreen(currentGame);
    };
    document.getElementById('search').oninput = function(e) { renderGrid(e.target.value); };

    // Performance mode toggle
    document.getElementById('perf-btn').onclick = function() {
      perfMode = !perfMode;
      document.body.classList.toggle('perf', perfMode);
      this.classList.toggle('active', perfMode);
      this.textContent = perfMode ? '⚡ Perf: ON' : '⚡ Perf: OFF';
    };

    // Add game modal
    document.getElementById('add-btn').onclick = function() {
      document.getElementById('game-name').value = '';
      document.getElementById('game-image').value = '';
      document.getElementById('game-embed').value = '';
      document.getElementById('add-modal').classList.add('active');
    };
    document.getElementById('cancel-add').onclick = function() {
      document.getElementById('add-modal').classList.remove('active');
    };
    document.getElementById('save-add').onclick = function() {
      var name = document.getElementById('game-name').value.trim();
      var embed = document.getElementById('game-embed').value.trim();
      var img = document.getElementById('game-image').value.trim();
      if (!name || !embed) return;
      var g = { id: (crypto.randomUUID ? crypto.randomUUID() : Date.now().toString()), name: name, embedCode: embed, imageUrl: img, createdAt: Date.now(), categoryId: 'uncategorized' };
      games.push(g);
      var unc = categories.find(function(c){ return c.id === 'uncategorized'; });
      if (unc) unc.gameIds.push(g.id);
      save();
      renderGrid(document.getElementById('search').value);
      document.getElementById('add-modal').classList.remove('active');
    };

    renderGrid();
  </script>
