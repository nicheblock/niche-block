    .card:hover .card-img { transform: scale(1.08); }
    .card-play {
      position: absolute; inset: 0; background: rgba(0,0,0,0.6);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.25s;
    }
    .card:hover .card-play { opacity: 1; }
    .card-play-icon { font-size: 2.5rem; color: var(--hc); filter: drop-shadow(0 0 8px var(--hc)); }
    .card-body { padding: 0.65rem 0.9rem; }
    .card-title { font-weight: 600; font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
