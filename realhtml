  <style>
    :root { --hc: #ffffff; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: "Press Start 2P", sans-serif; background: linear-gradient(135deg, #5e5d5f, #ffffff) fixed; color: #fff; min-height: 100vh; }
    .header {
      position: sticky; top: 0; z-index: 40;
      display: flex; justify-content: space-between; align-items: center;
      padding: 1rem 2rem; gap: 1rem;
      background: rgba(0,0,0,0.6); backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .header-left { display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }
    .logo { height: 36px; width: auto; border-radius: 8px; }
    .site-title { font-size: 1.4rem; font-weight: 700; white-space: nowrap; }
    .search-input {
      padding: 0.5rem 1rem; border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(0,0,0,0.3); color: white;
      width: min(300px, 100%); font-family: inherit; font-size: 0.9rem;
    }
    .search-input:focus { outline: none; border-color: var(--hc); }
    .header-actions { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
    .perf-btn {
      padding: 0.4rem 0.9rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2);
      background: transparent; color: rgba(255,255,255,0.6); cursor: pointer;
      font-family: inherit; font-size: 0.8rem; font-weight: 600; transition: all 0.2s;
    }
    .perf-btn.active { background: #facc15; border-color: #facc15; color: #000; }
    .main { padding: 2rem; max-width: 1400px; margin: 0 auto; }
    .category-section { margin-bottom: 2.5rem; }
    .category-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
    .category-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: var(--hc); white-space: nowrap; }
    .category-count { font-size: 0.7rem; color: rgba(255,255,255,0.35); }
    .category-line { flex: 1; height: 1px; background: linear-gradient(90deg, color-mix(in srgb, var(--hc) 30%, transparent), transparent); }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1.25rem; }
    /* icon card */
    .card {
